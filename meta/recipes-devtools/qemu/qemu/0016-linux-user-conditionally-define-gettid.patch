From 7e59f71c7d629bb8e6a6a9de164bc2b04c4606ef Mon Sep 17 00:00:00 2001
From: Daniel P. Berrange <berrange@redhat.com>
Date: Tue, 19 Mar 2019 17:07:02 +0000
Subject: [PATCH] linux-user: conditionally define gettid on newer glibc

Backport of the upstream QEMU fix for glibc exposing gettid() in unistd.h.
Without this, qemu-native 2.11.1 fails to build on Ubuntu 22.04.

Upstream-Status: Backport

Signed-off-by: Daniel P. Berrange <berrange@redhat.com>
---
 configure            | 16 ++++++++++++++++
 linux-user/syscall.c |  6 ++++--
 2 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/configure b/configure
index 7071f52584..fe980328b2 100755
--- a/configure
+++ b/configure
@@ -4276,6 +4276,21 @@ if test "$darwin" != "yes" -a "$mingw32" != "yes" -a "$solaris" != yes -a \
     libs_softmmu="-lutil $libs_softmmu"
 fi
 
+# Check if glibc exposes gettid()
+gettid=no
+cat > $TMPC << EOF
+#include <unistd.h>
+
+int main(void)
+{
+    gettid();
+    return 0;
+}
+EOF
+if compile_prog "" "" ; then
+  gettid=yes
+fi
+
+
 ##########################################
 # spice probe
 if test "$spice" != "no" ; then
@@ -6647,6 +6662,9 @@ fi
 if test "$splice" = "yes" ; then
   echo "CONFIG_SPLICE=y" >> $config_host_mak
 fi
+if test "$gettid" = "yes" ; then
+  echo "CONFIG_GETTID=y" >> $config_host_mak
+fi
 if test "$eventfd" = "yes" ; then
   echo "CONFIG_EVENTFD=y" >> $config_host_mak
 fi
diff --git a/linux-user/syscall.c b/linux-user/syscall.c
index 208fd1813d..70eb0d64f4 100644
--- a/linux-user/syscall.c
+++ b/linux-user/syscall.c
@@ -256,14 +256,16 @@
 #define TARGET_NR__llseek TARGET_NR_llseek
 #endif
 
-#ifdef __NR_gettid
+#ifndef CONFIG_GETTID
+# ifdef __NR_gettid
 _syscall0(int, gettid)
-#else
+# else
 /* This is a replacement for the host gettid() and must return a host
    errno. */
 static int gettid(void) {
     return -ENOSYS;
 }
+# endif
 #endif
 #if defined(TARGET_NR_getdents) && defined(__NR_getdents)
 _syscall3(int, sys_getdents, uint, fd, struct linux_dirent *, dirp, uint, count);
-- 
2.20.1
